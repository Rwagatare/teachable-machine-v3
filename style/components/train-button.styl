// Not imported by main.styl (dead file). Kept tokenised so it is harmless if
// it is ever imported again; Train buttons are styled in buttons.styl.

.train-button {
	position: absolute
	top: -40px
	left: 50%
	z-index: 20
	padding: var(--space-2) var(--space-5)
	color: var(--color-on-accent)
	text-align: center
	text-style(subheadline)
	font-weight: 600
	background: unquote('var(--color-accent-fill, var(--color-accent))')
	border-radius: var(--radius-pill)
	transform: translateX(-50%)
	cursor: pointer
	transition: filter var(--duration-fast) var(--ease-standard)

	@media (hover: hover) {
		&:hover {
			filter: brightness(1.08)
		}
	}

	&.training {
		color: var(--color-label)
		background: var(--color-fill)
		cursor: wait
	}
}