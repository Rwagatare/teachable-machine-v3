// ---------------------------------------------------------------------------
// The machine: Input -> Learning -> Output, joined by wires.
//
// Layout is keyed to available width only:
//   compact (< 700px)   one column in task order: camera, classes, output
//   medium  (700-1099)  same order; class cards sit side by side
//   wide    (>= 1100px) three columns with the wires between them
// The wires are SVG drawn by WiresLeft.js / WiresRight.js from the live
// layout, so they follow whichever arrangement is active.
// ---------------------------------------------------------------------------

$machine-medium = 700px
$machine-wide = 1100px
$machine-classes = 'green' 'purple' 'orange' 'red' 'blue' 'yellow' 'teal' 'neutral'

// var(--class-<name><suffix>) as a literal (Stylus can't build var() itself)
class-var(hue, suffix = '') {
	return unquote('var(--class-' + hue + suffix + ')')
}

.disabled {
	pointer-events: none
}

.dimmed {
	-webkit-filter: grayscale(25%)
	filter: grayscale(25%)
	opacity: 0.3
}

.machine {
	// @stylint off (custom property)
	--wire-neutral: var(--color-separator)
	// @stylint on
	position: relative
	overflow-x: hidden
	overflow-x: clip
	padding-top: var(--space-7)
	padding-right: unquote('max(var(--space-4), env(safe-area-inset-right))')
	padding-bottom: var(--space-8)
	padding-left: unquote('max(var(--space-4), env(safe-area-inset-left))')
	background: var(--color-bg)
	color: var(--color-label)
	text-align: left
	text-style(subheadline)
}

.machine__sections {
	display: flex
	flex-direction: column
	align-items: center
	max-width: 1360px
	margin-right: auto
	margin-left: auto
}

// ---------------------------------------------------------------------------
// Sections and cards
// ---------------------------------------------------------------------------

.section {
	position: relative
	width: 100%
	min-width: 0
	max-width: 560px
}

.section--disabled {
	pointer-events: none
}

.section__header {
	display: flex
	align-items: center
	justify-content: space-between
	gap: var(--space-2)
	min-height: 44px
	margin-bottom: var(--space-2)
	padding: 0 var(--space-1)
}

.section__title {
	display: flex
	align-items: center
	min-height: 44px
	margin: 0 0 var(--space-2)
	padding: 0 var(--space-1)
	color: var(--color-label-secondary)
	text-align: left
	text-transform: none
	text-style(headline)
}

.section__header .section__title {
	margin: 0
	padding: 0
}

.section__container {
	position: relative
	padding: var(--space-4)
	background: var(--color-surface)
	border-radius: var(--radius-l)
	box-shadow: var(--shadow-card)
}

// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------

.section--input .section__container {
	padding: var(--space-2)
}

.input__media {
	position: relative
	display: flex
	align-items: center
	justify-content: center
	width: 100%
	// @stylint off (property unknown to the linter)
	aspect-ratio: 1 / 1
	// @stylint on
	max-height: 60vh
	max-height: 60svh
	margin: 0
	overflow: hidden
	background: var(--color-fill)
	// concentric with the card: outer radius minus the card's padding
	border-radius: calc(var(--radius-l) - var(--space-2))

	@supports not (aspect-ratio: 1 / 1) {
		height: 280px
	}
}

.input__camera {
	width: 100%
	height: 100%
	display: flex
	align-items: center
	justify-content: center
}

.input__media video,
.input__media canvas,
.input__media img,
.input__camera-video {
	display: block
	width: 100%
	height: 100%
	object-fit: contain
}

// Switch Camera: floating control over the video, so it gets glass.
.input__media__flip {
	position: absolute
	right: calc(var(--space-2) + var(--space-3))
	bottom: calc(var(--space-2) + var(--space-3))
	z-index: 2
	display: inline-flex
	align-items: center
	justify-content: center
	width: 44px
	height: 44px
	margin: 0
	padding: 0
	color: var(--color-label)
	border-radius: 50%
	cursor: pointer
	-webkit-appearance: none
	appearance: none
	-webkit-tap-highlight-color: transparent
	glass(clear)
	press-feedback()

	svg {
		width: 24px
		height: 24px
	}

	&[hidden] {
		display: none
	}
}

// Camera permission panel (shown by WebcamClassifier.js when access is
// blocked; text written by index.js). A floating notice, but it's text people
// must read, so it's a solid card rather than glass.
.input-permission {
	display: none
	position: fixed
	top: unquote('max(var(--space-4), env(safe-area-inset-top))')
	right: unquote('max(var(--space-4), env(safe-area-inset-right))')
	left: unquote('max(var(--space-4), env(safe-area-inset-left))')
	z-index: 999
	max-width: 440px
	margin: 0 auto
	padding: var(--space-5)
	color: var(--color-label)
	background: var(--color-surface-elevated)
	border-radius: var(--radius-l)
	box-shadow: var(--shadow-floating)
	cursor: pointer
}

.input__media__activate {
	margin: 0 0 var(--space-4)
	text-style(callout)

	.camera-icon {
		display: inline-block
		max-width: 1.5em
		height: auto
		vertical-align: middle
	}
}

.input-permission__reload {
	width: 100%
}

// ---------------------------------------------------------------------------
// Learning
// ---------------------------------------------------------------------------

.section--learning {
	max-width: 960px
}

.section--learning .section__container {
	display: grid
	grid-template-columns: minmax(0, 1fr)
	gap: var(--space-3)
	padding: 0
	background: none
	border-radius: 0
	box-shadow: none
}

.learning__hint {
	margin: calc(var(--space-1) * -1) var(--space-1) var(--space-3)
	color: var(--color-label-secondary)
	text-style(footnote)
}

.learning-condensed-button {
	display: inline-flex
	align-items: center
	gap: var(--space-1)
	min-height: 44px
	margin: 0
	padding: 0 var(--space-3)
	color: var(--color-label)
	font: inherit
	text-style(subheadline)
	font-weight: 500
	background: var(--color-fill-secondary)
	border: 0
	border-radius: var(--radius-pill)
	cursor: pointer
	-webkit-appearance: none
	appearance: none
	press-feedback()

	&[aria-pressed='true'] {
		color: var(--color-on-accent)
		background: unquote('var(--color-accent-fill, var(--color-accent))')
	}
}

.learning-condensed-button__icon {
	width: 16px
	height: 16px
	transition: transform var(--duration) var(--ease-standard)

	path {
		fill: none
		stroke: currentColor
		stroke-width: 2
		// @stylint off (SVG properties unknown to the linter)
		stroke-linecap: round
		stroke-linejoin: round
		// @stylint on
	}
}

.learning-condensed-button[aria-pressed='true'] .learning-condensed-button__icon {
	transform: rotate(180deg)
}

// Class card
.learning__class {
	position: relative
	display: flex
	flex-direction: column
	gap: var(--space-3)
	min-width: 0
	padding: var(--space-4)
	color: var(--color-label)
	text-align: left
	background: var(--color-surface)
	border-radius: var(--radius-l)
	box-shadow: var(--shadow-card)
	outline: 2px solid transparent
	outline-offset: 0
	transition: outline-color var(--duration) var(--ease-standard)
}

.learning__class--disabled {
	pointer-events: none
}

.learning__class-header {
	display: flex
	flex-wrap: wrap
	align-items: center
	gap: var(--space-1) var(--space-2)
	min-height: 44px
	margin: calc(var(--space-2) * -1) 0
}

.learning__class-name {
	display: flex
	align-items: center
	gap: var(--space-2)
	margin: 0
	color: var(--color-label)
	text-style(headline)
	font-weight: 500

	&:before {
		content: ''
		flex: none
		width: 10px
		height: 10px
		border-radius: 50%
	}
}

.learning__class--detected .learning__class-name {
	font-weight: 700
}

.learning__class-badge {
	display: inline-flex
	align-items: center
	// @stylint off
	gap: 2px
	// @stylint on
	padding: 2px var(--space-2) 2px 6px
	border-radius: var(--radius-pill)
	text-style(caption)
	font-weight: 600

	&[hidden] {
		display: none
	}
}

.icon-check {
	flex: none
	width: 1.1em
	height: 1.1em

	path {
		fill: none
		stroke: currentColor
		stroke-width: 2
		// @stylint off (SVG properties unknown to the linter)
		stroke-linecap: round
		stroke-linejoin: round
		// @stylint on
	}
}

// Per-class Reset: tertiary text button, always reachable (no hover needed)
.link--reset {
	display: inline-flex
	align-items: center
	justify-content: center
	min-width: 44px
	min-height: 44px
	margin: 0 calc(var(--space-2) * -1) 0 auto
	padding: 0 var(--space-2)
	color: var(--color-accent)
	font: inherit
	text-style(subheadline)
	text-decoration: none
	background: none
	border: 0
	border-radius: var(--radius-s)
	cursor: pointer
	-webkit-appearance: none
	appearance: none
	press-feedback()

	@media (hover: hover) {
		&:hover {
			background: var(--color-fill-secondary)
		}
	}

	&[hidden] {
		display: none
	}
}

.examples {
	display: flex
	align-items: center
	gap: var(--space-3)
}

.examples__wrapper {
	flex: none
	position: relative
	width: 88px
	height: 88px
	overflow: hidden
	background: var(--color-fill)
	border-radius: var(--radius-s)
}

.examples__viewer {
	display: block
	width: 100%
	height: 100%
	transform: scaleX(-1)
}

.examples__info {
	display: flex
	flex: 1
	flex-direction: column
	gap: var(--space-2)
	min-width: 0
}

.machine__status {
	margin: 0
	color: var(--color-label-secondary)
	text-align: left
	text-transform: none
	text-style(footnote)
}

.examples__status {
	display: flex
	flex-wrap: wrap
	align-items: center
	gap: 0 var(--space-1)
	font-variant-numeric: tabular-nums
}

.examples__counter {
	color: var(--color-label)
	font-weight: 600
}

.examples__ready {
	display: inline-flex
	align-items: center
	// @stylint off
	gap: 2px
	// @stylint on
	color: var(--color-label)
	font-weight: 600

	.icon-check {
		color: var(--color-success)
	}

	&[hidden] {
		display: none
	}
}

.examples__progress,
.machine__meter {
	position: relative
	width: 100%
	overflow: hidden
	background: var(--color-fill)
	border-radius: var(--radius-pill)
}

.examples__progress {
	height: 4px
}

.machine__meter {
	height: 8px
}

.examples__progress-fill,
.machine__value {
	width: 100%
	height: 100%
	transform: scaleX(0)
	transform-origin: left center
}

.examples__progress-fill {
	transition: transform var(--duration) var(--ease-standard)
}

.machine__value {
	background: var(--color-accent)
	transition: transform var(--duration) linear
}

.confidence {
	display: flex
	flex-direction: column
	gap: var(--space-1)
}

.confidence__header {
	display: flex
	align-items: baseline
	justify-content: space-between
	gap: var(--space-2)
}

.machine__percentage {
	color: var(--color-label)
	font-variant-numeric: tabular-nums
	text-style(footnote)
	font-weight: 600
}

.button--record {
	width: 100%
}

// Compact View (toggle in the Learning header, below the wide layout): just
// name, meter and Train
@media screen and (max-width: ($machine-wide - 1px)) {
	.section--learning.condensed {
		.learning__hint,
		.examples__wrapper,
		.examples__status,
		.examples__progress {
			display: none
		}
	}
}

// Per-class colours
for cls in $machine-classes {
	.learning__class--{cls} .learning__class-name:before,
	.learning__class--{cls} .examples__progress-fill,
	.machine__value--color-{cls} {
		background: class-var(cls)
	}

	.learning__class--{cls}.learning__class--detected {
		outline-color: class-var(cls)
	}

	.learning__class--{cls} .learning__class-badge {
		color: class-var(cls, '-on')
		background: class-var(cls)
	}

	.wire-signal--{cls} {
		stroke: class-var(cls)
	}

	.wire-bulb--{cls} circle {
		fill: class-var(cls)
	}
}

// ---------------------------------------------------------------------------
// Wires
// ---------------------------------------------------------------------------
// @stylint off (SVG properties unknown to the linter)

.wires {
	position: relative
	flex: none
	width: 100%
	max-width: 960px
	height: 56px
}

.wires--right {
	height: 72px
}

.wires--disabled {
	pointer-events: none
}

.wires-svg {
	position: absolute
	top: 0
	left: 0
	display: block
	width: 100%
	height: 100%
	overflow: visible
	pointer-events: none
}

.wire,
.wire-signal {
	fill: none
	stroke-width: 3
	stroke-linecap: round
}

.wire {
	stroke: var(--wire-neutral)
}

.wire-signal {
	opacity: 0
	transition: opacity var(--duration-fast) var(--ease-standard)

	&.is-lit {
		opacity: 1
	}
}

// Training: signal flows from the camera into the class
.wire-signal--flow.is-lit {
	stroke-dasharray: 8 10
	animation: wire-flow 0.8s linear infinite
}

// Detection: the wire draws itself to the bulb once (--wire-length is set
// by WiresRight.js)
.wire-signal--draw {
	stroke-dasharray: var(--wire-length, 2000)
	stroke-dashoffset: var(--wire-length, 2000)

	&.is-lit {
		stroke-dashoffset: 0
		transition: stroke-dashoffset var(--duration-slow) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard)
	}
}

.wire-bulb__light {
	opacity: 0.35
	transition: opacity var(--duration) var(--ease-standard)
}

.wire-bulb__glow {
	opacity: 0
	transform: scale(0.5)
	transform-box: fill-box
	transform-origin: center
	transition: opacity var(--duration-slow) var(--ease-standard), transform var(--duration-slow) var(--ease-spring)
}

.wire-bulb.is-lit {
	.wire-bulb__light {
		opacity: 1
	}

	.wire-bulb__glow {
		opacity: 0.3
		transform: scale(1)
	}
}

@keyframes wire-flow {
	to {
		stroke-dashoffset: -18
	}
}

// Reduced motion: a steady lit wire instead of the flowing dashes
@media (prefers-reduced-motion: reduce) {
	.wire-signal--flow.is-lit {
		stroke-dasharray: none
		animation: none
	}

	.wire-bulb__glow {
		transform: none
	}
}

// @stylint on

// ---------------------------------------------------------------------------
// Recording helpers that still live here
// ---------------------------------------------------------------------------

.button--share {
	height: 60px
	margin-top: var(--space-4)
}

.recording-download-container {
	position: relative
	top: 29px
	display: none
	margin-left: 15px
	color: $color__white

	a {
		color: $color__white
	}
}

// ---------------------------------------------------------------------------
// Medium: class cards side by side
// ---------------------------------------------------------------------------

@media screen and (min-width: $machine-medium) {
	.section--learning .section__container {
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr))
	}
}

// ---------------------------------------------------------------------------
// Wide: three columns joined by wires
// ---------------------------------------------------------------------------

@media screen and (min-width: $machine-wide) {
	.machine {
		padding-top: var(--space-8)
	}

	.machine__sections {
		flex-direction: row
		align-items: center
		justify-content: center
	}

	.section {
		max-width: none
	}

	.section--input {
		flex: 0 1 300px
	}

	.section--learning {
		flex: 0 1 400px
	}

	.section--output {
		flex: 0 1 320px
	}

	.section--learning .section__container {
		grid-template-columns: minmax(0, 1fr)
	}

	.wires,
	.wires--right {
		flex: 0 0 unquote('clamp(40px, 5vw, 80px)')
		align-self: stretch
		width: auto
		max-width: none
		height: auto
	}

	// Compact View is for small screens; the full cards fit here
	.learning-condensed-button {
		display: none
	}
}
