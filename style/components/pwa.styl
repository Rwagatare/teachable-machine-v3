// PWA chrome: the floating Install button, the iOS "Add to Home Screen"
// hint and the offline indicator (all created by PWAUtils.js), plus
// standalone-mode tweaks. These float over content, so they use glass().
// Components own their own safe-area padding; only the floating elements
// here are inset from the screen edges.

// Installed app: same page background as in the browser (tokens), no bounce
// at the page edges, and no install prompts.
@media all and (display-mode: standalone) {
	body {
		min-height: 100vh
		// @stylint off
		overscroll-behavior-y: none
		// @stylint on
	}

	.pwa-install-button,
	.ios-install-banner {
		display: none !important
	}
}

.pwa-install-button,
.ios-install-banner,
.offline-indicator {
	-webkit-tap-highlight-color: transparent
	touch-action: manipulation
	color: var(--color-label)
	opacity: 0
	transition: opacity var(--duration) var(--ease-standard), transform var(--duration) var(--ease-standard)

	&[hidden] {
		display: none
	}

	&.is-visible,
	&.show {
		opacity: 1
		transform: none
	}
}

// Install button: floating glass pill, bottom trailing corner
.pwa-install-button {
	position: fixed
	right: calc(env(safe-area-inset-right) + var(--space-4))
	bottom: calc(env(safe-area-inset-bottom) + var(--space-4))
	z-index: 900
	display: inline-flex
	align-items: center
	gap: var(--space-2)
	min-width: 44px
	min-height: 44px
	padding: var(--space-2) var(--space-4)
	border-radius: var(--radius-pill)
	font-family: inherit
	text-style(headline)
	cursor: pointer
	transform: translateY(12px)
	glass()

	// Press state (press-feedback() would replace the entrance transition)
	&.is-visible:active {
		transform: scale(0.97)
		opacity: 0.8
	}

	@media (prefers-reduced-motion: reduce) {
		&.is-visible:active {
			transform: none
		}
	}

	svg {
		flex: none
		display: block
		color: var(--color-accent)
	}
}

// Step aside while the launch screen is up (it locks scrolling with
// body.no-scroll) or the tutorial bar is pinned to the bottom of the screen
body.no-scroll .pwa-install-button {
	visibility: hidden
	opacity: 0
}

// @stylint off (:has() unknown to the linter)
body:has(.wizard--fixed) .pwa-install-button {
	visibility: hidden
	opacity: 0
}
// @stylint on

// iOS install hint: glass sheet along the bottom edge
.ios-install-banner {
	position: fixed
	right: calc(env(safe-area-inset-right) + var(--space-3))
	bottom: calc(env(safe-area-inset-bottom) + var(--space-3))
	left: calc(env(safe-area-inset-left) + var(--space-3))
	z-index: 950
	display: flex
	align-items: center
	gap: var(--space-3)
	max-width: 480px
	margin: 0 auto
	padding: var(--space-3) var(--space-2) var(--space-3) var(--space-4)
	border-radius: var(--radius-l)
	transform: translateY(24px)
	glass()
}

.ios-install-banner__icon {
	flex: none
	width: 40px
	height: 40px
	border-radius: var(--radius-s)
}

.ios-install-banner__text {
	flex: 1
	min-width: 0
}

.ios-install-banner__title,
.ios-install-banner__body {
	margin: 0
}

.ios-install-banner__title {
	text-style(headline)
}

.ios-install-banner__body {
	color: var(--color-label-secondary)
	text-style(subheadline)
}

.ios-install-banner__close {
	flex: none
	display: inline-flex
	align-items: center
	justify-content: center
	width: 44px
	height: 44px
	padding: 0
	border: 0
	border-radius: var(--radius-pill)
	background: transparent
	color: var(--color-label-secondary)
	cursor: pointer
	press-feedback()

	svg {
		display: block
	}
}

// Offline indicator: small glass pill, top centre. Informational only.
.offline-indicator {
	position: fixed
	top: calc(env(safe-area-inset-top) + var(--space-3))
	left: 50%
	z-index: 1001
	max-width: calc(100% - var(--space-6))
	padding: var(--space-2) var(--space-4)
	border-radius: var(--radius-pill)
	text-style(footnote)
	font-weight: 600
	text-align: center
	pointer-events: none
	transform: translate(-50%, -8px)
	glass()

	&.show {
		transform: translate(-50%, 0)
	}

	&:empty {
		display: none
	}
}