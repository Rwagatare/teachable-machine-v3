.footer {
	max-width: 65ch
	margin: var(--space-8) auto 0
	padding: var(--space-6) calc(var(--space-4) + env(safe-area-inset-right)) calc(var(--space-8) + env(safe-area-inset-bottom)) calc(var(--space-4) + env(safe-area-inset-left))
	border-top: 1px solid var(--color-separator)
	color: var(--color-label-secondary)
	text-style(footnote)
}

.footer__logo {
	display: inline-block
	max-width: 400px
	border-radius: var(--radius-xs)
}

// The artwork is light grey (#CCC); darken it in light mode so the text in
// it stays readable on the page background.
.footer__image {
	display: block
	width: 100%
	height: auto
	filter: brightness(0.5)

	+when-dark() {
		filter: none
	}
}

.footer__links {
	display: flex
	flex-wrap: wrap
	align-items: center
	gap: 0 var(--space-4)
	margin-top: var(--space-3)
}

.footer .link--privacy {
	display: inline-flex
	align-items: center
	min-height: 44px
	color: var(--color-label-secondary)
}

// Tertiary, destructive: a plain text button tinted with the danger colour
.footer__clear-data {
	display: inline-flex
	align-items: center
	min-height: 44px
	padding: 0 var(--space-3)
	background: transparent
	border: 0
	border-radius: var(--radius-s)
	color: var(--color-danger)
	font-family: inherit
	text-style(footnote)
	font-weight: 600
	cursor: pointer
	press-feedback()

	&:hover {
		background: var(--class-red-tint)
	}
}