// ---------------------------------------------------------------------------
// Tutorial bar
//
// A floating glass bar with the caption, narration controls and Skip. While
// its place in the page (.wizard__wrapper, which reserves the bar's height)
// is below the fold, Wizard.js adds .wizard--fixed and the bar floats pinned
// to the bottom of the screen, above the safe area.
// ---------------------------------------------------------------------------

.wizard__wrapper {
	position: relative
	z-index: 100
	width: 100%
	overflow: hidden
}

// Transparent positioning box; only the bar itself takes taps.
.wizard {
	position: relative
	width: 100%
	pointer-events: none
	padding-top: var(--space-3)
	padding-right: calc(env(safe-area-inset-right) + var(--space-3))
	padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-3))
	padding-left: calc(env(safe-area-inset-left) + var(--space-3))
}

.wizard--fixed {
	position: fixed
	right: 0
	bottom: 0
	left: 0
}

.wizard [hidden] {
	display: none !important
}

.wizard__inner {
	display: grid
	grid-template-columns: auto auto minmax(0, 1fr) auto
	grid-template-areas: 'sound pause text skip'
	align-items: center
	gap: var(--space-2) var(--space-3)
	max-width: 960px
	margin: 0 auto
	padding: var(--space-2) var(--space-3)
	border-radius: var(--radius-l)
	color: var(--color-label)
	pointer-events: auto
	glass()
}

// Round icon buttons: sound and pause
.wizard__icon-button {
	display: inline-flex
	align-items: center
	justify-content: center
	width: 44px
	height: 44px
	margin: 0
	padding: 0
	appearance: none
	border: 0
	border-radius: var(--radius-pill)
	background: var(--color-fill-secondary)
	color: var(--color-label)
	cursor: pointer
	press-feedback()

	&:hover {
		background: var(--color-fill)
	}
}

.wizard__icon {
	width: 22px
	height: 22px
	fill: currentColor
}

.wizard__sound-button {
	grid-area: sound
}

.wizard__pause-button {
	grid-area: pause
}

// Icon swaps follow the button state
.wizard__icon--sound-off,
.wizard__sound-button[aria-pressed="true"] .wizard__icon--sound-on,
.wizard__icon--play,
.wizard__pause-button--paused .wizard__icon--pause {
	display: none
}

.wizard__sound-button[aria-pressed="true"] .wizard__icon--sound-off,
.wizard__pause-button--paused .wizard__icon--play {
	display: block
}

// Caption and its progress
.wizard__text {
	grid-area: text
	display: flex
	flex-direction: column
	justify-content: center
	gap: var(--space-2)
	min-width: 0
	min-height: 44px
	text-align: left
}

.wizard__text-inner {
	margin: 0
	text-style(body)
	color: var(--color-label)
}

.wizard__timer {
	position: relative
	width: 100%
	max-width: 160px
	height: 3px
	border-radius: var(--radius-pill)
	background: var(--color-fill)
	overflow: hidden
}

.wizard__timer-fill {
	width: 0
	height: 100%
	border-radius: inherit
	background: var(--color-accent)
}

.wizard__skip-button {
	grid-area: skip
	min-height: 44px
	margin: 0
	padding: 0 var(--space-4)
	appearance: none
	border: 0
	border-radius: var(--radius-pill)
	background: var(--color-fill-secondary)
	color: var(--color-label)
	text-style(subheadline)
	font-weight: 600
	white-space: nowrap
	cursor: pointer
	press-feedback()

	&:hover {
		background: var(--color-fill)
	}
}

// Narrow screens: caption on top, controls in a row underneath
@media (max-width: 599px) {
	.wizard__inner {
		grid-template-columns: auto auto minmax(0, 1fr)
		grid-template-areas: 'text text text' 'sound pause skip'
		padding: var(--space-3)
	}

	.wizard__text-inner {
		text-style(callout)
	}

	.wizard__skip-button {
		justify-self: end
	}
}

// ---------------------------------------------------------------------------
// Pointers and examples shown by the tutorial (decorative, aria-hidden)
// ---------------------------------------------------------------------------

.wizard__arrow {
	position: absolute
	z-index: 100 !important
	top: 0
	left: 0
	pointer-events: none
	display: none
}

.wizard__gif {
	z-index: 100000
	position: absolute
	width: 180px
	height: 194px
	background-image: url(assets/wizard/gif-backdrop.svg)
	background-size: contain
	background-position: 0 0
	background-repeat: no-repeat
	display: none
}

.wizard__gif-mask {
	position: relative
	width: 140px
	height: 140px
	overflow: hidden
	margin-top: 35px
	margin-left: 20px
}

.wizard__gif-image {
	width: 100%
}

.wizard__emoji {
	z-index: 100000
	position: absolute
	width: 180px
	height: 194px
	background-image: url(assets/wizard/gif-backdrop.svg)
	background-size: contain
	background-position: 0 0
	background-repeat: no-repeat
	display: none
	pointer-events: none
}

.wizard__emoji-mask {
	position: relative
	width: 140px
	height: 140px
	overflow: hidden
	margin-top: 35px
	margin-left: 20px
	display: flex
	align-items: center
	justify-content: center
}

.wizard__emoji-element {
	width: 80px
	height: 80px
	border-radius: var(--radius-m)
	background: var(--color-surface)
	box-shadow: var(--shadow-card)
	font-size: 60px
	line-height: 80px
	text-align: center
}

@media (max-width: 900px) {
	.wizard__arrow {
		opacity: 0
	}
}

@media (max-height: 680px) {
	.wizard__gif {
		top: -130px
		left: -100px
	}
}
