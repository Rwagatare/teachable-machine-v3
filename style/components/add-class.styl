// Add Class: a dashed "slot" below the class cards, available at every width.
// Disabled at the maximum (4 classes) with a short note underneath.
// Per-class colours for added classes live in components/machine.styl.

.add-class-container {
	display: flex
	flex-direction: column
	align-items: stretch
	gap: var(--space-2)
	margin-top: var(--space-3)
}

.add-class-button {
	display: flex
	align-items: center
	justify-content: center
	gap: var(--space-2)
	width: 100%
	min-height: 56px
	margin: 0
	padding: var(--space-3) var(--space-4)
	color: var(--color-accent)
	font: inherit
	text-style(headline)
	background: transparent
	border: 2px dashed var(--color-label-tertiary)
	border-radius: var(--radius-l)
	cursor: pointer
	-webkit-appearance: none
	appearance: none
	-webkit-tap-highlight-color: transparent
	press-feedback()

	@media (hover: hover) {
		&:hover {
			background: var(--color-fill-secondary)
		}
	}

	&:disabled {
		color: var(--color-label-tertiary)
		border-color: var(--color-fill)
		cursor: default
		transform: none
		opacity: 1
	}
}

.add-class-button__icon {
	flex: none
	width: 20px
	height: 20px

	path {
		fill: none
		stroke: currentColor
		stroke-width: 2.2
		// @stylint off (SVG property unknown to the linter)
		stroke-linecap: round
		// @stylint on
	}
}

.add-class-note {
	margin: 0
	color: var(--color-label-secondary)
	text-align: center
	text-style(footnote)

	&[hidden] {
		display: none
	}
}