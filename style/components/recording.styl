// Video recorder: a modal sheet over a dimmed backdrop.
// Content card, so no glass here (glass is for floating controls only).

html.recording-open {
    overflow: hidden
}

.recording {
    position: fixed
    top: 0
    right: 0
    bottom: 0
    left: 0
    z-index: 1000
    display: flex
    align-items: center
    justify-content: center
    padding: calc(var(--space-4) + env(safe-area-inset-top)) calc(var(--space-4) + env(safe-area-inset-right)) calc(var(--space-4) + env(safe-area-inset-bottom)) calc(var(--space-4) + env(safe-area-inset-left))
    background: rgba(0, 0, 0, 0.4)
    opacity: 0
    transition: opacity var(--duration) var(--ease-standard)

    &.fadein {
        opacity: 1
    }

    // Author display rules would otherwise beat the hidden attribute
    &[hidden],
    [hidden] {
        display: none !important
    }
}

.recording__sheet {
    position: relative
    width: 100%
    max-width: 760px
    max-height: 100%
    overflow-y: auto
    // @stylint off
    overscroll-behavior: contain
    // @stylint on
    padding: var(--space-6)
    background: var(--color-surface-elevated)
    color: var(--color-label)
    border-radius: var(--radius-l)
    box-shadow: var(--shadow-floating)
    text-align: left
    transform: translateY(12px) scale(0.98)
    transition: transform var(--duration) var(--ease-standard)

    .fadein & {
        transform: none
    }

    &:focus {
        outline: none
    }
}

.recording__header {
    display: flex
    align-items: flex-start
    justify-content: space-between
    gap: var(--space-3)
}

.recording__title {
    margin: 0
    padding-top: var(--space-2)
    text-style(title-2)
}

.recording__close {
    flex: none
    display: inline-flex
    align-items: center
    justify-content: center
    width: 44px
    height: 44px
    margin: calc(var(--space-2) * -1) calc(var(--space-2) * -1) 0 0
    padding: 0
    border: 0
    border-radius: var(--radius-pill)
    background: var(--color-fill-secondary)
    color: var(--color-label-secondary)
    cursor: pointer
    press-feedback()

    svg {
        display: block
    }
}

.recording__message {
    margin: var(--space-2) 0 var(--space-4)
    color: var(--color-label-secondary)
    text-style(callout)
    max-width: 60ch
}

.recording__stage {
    width: 100%
    max-width: 680px
    margin: 0 auto
}

// The canvas and preview video are 680x340 internally and scale to fit
.recording__canvas,
.recording__video {
    display: block
    width: 100%
    max-width: 680px
    height: auto
    // @stylint off
    aspect-ratio: 2 / 1
    // @stylint on
    margin: 0 auto
    border-radius: var(--radius-m)
    background: var(--color-fill)
}

.recording__status-row {
    display: flex
    flex-wrap: wrap
    align-items: baseline
    justify-content: center
    gap: var(--space-1) var(--space-4)
    margin-top: var(--space-4)
    min-height: 1.5em
    text-align: center
}

.recording__timer {
    margin: 0
    text-style(title-3)
    font-variant-numeric: tabular-nums
}

.recording__status {
    margin: 0
    color: var(--color-label-secondary)
    text-style(callout)

    &:empty {
        display: none
    }
}

.recording__legal {
    display: flex
    align-items: center
    justify-content: center
    gap: var(--space-3)
    margin-top: var(--space-4)
    text-style(callout)

    label {
        display: flex
        align-items: center
        min-height: 44px
        cursor: pointer
    }
}

.recording__checkbox {
    flex: none
    width: 22px
    height: 22px
    margin: 0
    accent-color: var(--color-accent)
    cursor: pointer
}

.recording__actions {
    display: flex
    flex-direction: column
    align-items: center
    gap: var(--space-3)
    margin-top: var(--space-4)
    text-align: center
}

.recording-start__button {
    position: relative
}

// Waiting for the age confirmation. Stays focusable (aria-disabled) so the
// reason next to it can be discovered; clicks are ignored in Recording.js.
.recording-start__button--disabled {
    cursor: not-allowed
    opacity: 0.4
    filter: grayscale(40%)
}

.recording-download-container {
    display: flex
    flex-wrap: wrap
    align-items: center
    justify-content: center
    gap: var(--space-3)
    margin: 0
}

.recording__download,
.recording__again {
    display: inline-flex
    align-items: center
    justify-content: center
    min-height: 44px
    min-width: 44px
    padding: var(--space-2) var(--space-5)
    border-radius: var(--radius-pill)
    font-family: inherit
    text-style(headline)
    text-decoration: none
    cursor: pointer
    press-feedback()
}

.recording__download {
    background: var(--color-accent-fill)
    color: var(--color-on-accent)
    border: 0
}

.recording__again {
    background: transparent
    color: var(--color-accent)
    border: 1.5px solid var(--color-accent)
}

.sharing-notice {
    margin: 0
    color: var(--color-label-secondary)
    text-style(footnote)
}

// 10-second progress sweep on the Stop Recording button (decorative; the
// timer and status text carry the same information)
.recording-start__button.animate {
    overflow: hidden

    &:after {
        content: ''
        position: absolute
        top: 0
        bottom: 0
        left: 0
        width: 100%
        z-index: 2
        background: #FFFFFF
        opacity: 0.2
        pointer-events: none
        transform-origin: left center
        animation: recording-progress 10s linear 1
    }
}

@keyframes recording-progress {
    0% {
        transform: scaleX(0)
    }
    100% {
        transform: scaleX(1)
    }
}

@media (prefers-reduced-motion: reduce) {
    .recording-start__button.animate:after {
        display: none
    }
}

@media screen and (max-width: 480px) {
    .recording__sheet {
        padding: var(--space-4)
    }
}