// Emoji output: live viewer, one thumbnail per class, emoji search sheet.
// Class colours come from --output-class* (see outputs.styl).

.emoji__edit {
	position: relative
	display: flex
	flex-direction: column
	gap: var(--space-3)
}

.emoji__viewer {
	display: flex
	flex-direction: column
	align-items: center
	justify-content: center
	gap: var(--space-2)
	min-height: 180px
	max-height: 280px
	aspect-ratio: 4 / 3 // @stylint ignore
	padding: var(--space-4)
	border-radius: var(--radius-m)
	background: var(--output-class-tint, var(--color-fill-secondary))
	box-shadow: inset 0 0 0 2px var(--output-class, transparent)
	transition: background-color var(--duration) var(--ease-standard), box-shadow var(--duration) var(--ease-standard)
}

.emoji__viewer--rest {
	background: var(--color-fill-secondary)
	box-shadow: none
}

.emoji__viewer-glyph {
	min-height: 1.15em
	font-family: $output-emoji-font
	font-size: unquote('clamp(64px, 22vw, 112px)')
	line-height: 1.15
}

@supports (font-size: 1cqi) {
	.emoji__viewer-glyph {
		font-size: unquote('clamp(56px, 30cqi, 120px)')
	}
}

.emoji__viewer-caption {
	color: var(--color-label-secondary)
	text-align: center
	text-style(subheadline)

	.output__class-tag {
		color: var(--color-label)
		text-style(headline)
	}
}

// Thumbnails: one button per class
// Thumbnails share the width; at large text sizes they wrap
.emoji__edit-bar {
	display: flex
	flex-wrap: wrap
	justify-content: center
	gap: var(--space-2)
}

.emoji__thumb {
	flex: 1 1 0
	display: flex
	flex-direction: column
	align-items: center
	gap: var(--space-1)
	min-width: unquote('min(max-content, 100%)')
	max-width: 96px
	min-height: 44px
	margin: 0
	padding: var(--space-2) var(--space-1)
	border: 0
	border-radius: var(--radius-s)
	background: var(--color-bg)
	color: var(--color-label)
	font-family: inherit
	cursor: pointer
	-webkit-tap-highlight-color: transparent
	press-feedback()

	.output__class-tag {
		gap: var(--space-1)
		max-width: 100%
		text-style(caption)
		font-weight: 600
	}

	// The thumbnail already shows the class by name; no room for a swatch
	.output__swatch {
		display: none
	}
}

.emoji__thumb-emoji {
	font-family: $output-emoji-font
	font-size: 28px
	line-height: 1.2
}

@media (hover: hover) {
	.emoji__thumb:hover {
		box-shadow: inset 0 0 0 1px var(--output-class)
	}
}

// The class currently detected
.emoji__thumb--active {
	background: var(--output-class-tint)
	box-shadow: inset 0 0 0 2px var(--output-class)

	.output__class-tag {
		color: var(--color-label)
		font-weight: 700
	}
}

@media (hover: hover) {
	.emoji__thumb--active:hover {
		box-shadow: inset 0 0 0 2px var(--output-class)
	}
}

// Search sheet results
.emoji__search-results {
	display: grid
	grid-template-columns: repeat(auto-fill, minmax(48px, 1fr))
	gap: var(--space-1)
	padding-bottom: var(--space-2)
}

.emoji__search-item {
	min-width: 44px
	min-height: 48px
	margin: 0
	padding: 0
	border: 0
	border-radius: var(--radius-s)
	background: var(--color-bg)
	font-family: $output-emoji-font
	font-size: 28px
	line-height: 1
	cursor: pointer
	-webkit-tap-highlight-color: transparent
	press-feedback()
}

@media (hover: hover) {
	.emoji__search-item:hover {
		background: var(--output-class-tint, var(--color-fill-secondary))
	}
}