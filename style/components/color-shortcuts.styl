// Add the short variables for new colors at the end of the file
$green = $color__class-green--primary
$purple = $color__class-purple--primary
$orange = $color__class-orange--primary
$red = $color__class-red--primary
$blue = $color__class-blue--primary
$yellow = $color__class-yellow--primary
$teal = $color__class-teal--primary

$neutral = $color__class-neutral--primary

// Shortcuts to the adaptive class-colour tokens (preferred for new code; these
// are var() so never pass them to Stylus colour functions).
$class-green = var(--class-green)
$class-purple = var(--class-purple)
$class-orange = var(--class-orange)
$class-red = var(--class-red)
$class-blue = var(--class-blue)
$class-yellow = var(--class-yellow)
$class-teal = var(--class-teal)
$class-neutral = var(--class-neutral)
