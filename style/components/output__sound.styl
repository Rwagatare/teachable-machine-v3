// Sound output: per-class rows use the shared .output__row styles in
// outputs.styl. This file covers the sound picker sheet.

.output__sound-search-results {
	margin: 0
	padding: 0
	list-style: none
}

.output__sound-search-result {
	display: flex
	align-items: center
	gap: var(--space-1)
	border-bottom: 1px solid var(--color-separator)
}

.output__sound-search-result:last-child {
	border-bottom: 0
}

.output__sound-search-result[hidden] {
	display: none
}

.output__sound-search-play {
	color: var(--output-class, var(--color-accent))

	.output__icon {
		width: 18px
		height: 18px
	}
}

.output__sound-search-select {
	flex: 1 1 auto
	display: flex
	align-items: center
	gap: var(--space-2)
	min-width: 0
	min-height: 44px
	margin: 0
	padding: var(--space-2)
	border: 0
	border-radius: var(--radius-s)
	background: transparent
	color: var(--color-label)
	font-family: inherit
	text-align: left
	text-style(body)
	cursor: pointer
	-webkit-tap-highlight-color: transparent

	.output__icon {
		flex: none
		order: 2
		width: 20px
		height: 20px
		color: var(--output-class, var(--color-accent))
		visibility: hidden
	}

	&:active {
		background: var(--color-fill-secondary)
	}
}

@media (hover: hover) {
	.output__sound-search-select:hover {
		background: var(--output-class-tint, var(--color-fill-secondary))
	}
}

.output__sound-search-name {
	flex: 1 1 auto
	min-width: 0
	overflow-wrap: anywhere
}

// The class's current sound: checkmark + weight, not colour alone
.output__sound-search-result--current .output__sound-search-select {
	font-weight: 600

	.output__icon {
		visibility: visible
	}
}