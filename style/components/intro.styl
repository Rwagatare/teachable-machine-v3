// ---------------------------------------------------------------------------
// Launch screen
//
// One brand moment (the hand-drawn wordmark), a one-line value proposition
// and a clear choice between the tutorial and skipping it. The screen scrolls
// whenever its content is taller than the viewport (large text sizes,
// landscape phones), and everything pinned to an edge respects the safe area.
// ---------------------------------------------------------------------------

$intro-content-width = 34em

.intro {
	position: fixed
	top: 0
	right: 0
	bottom: 0
	left: 0
	z-index: 101
	display: flex
	flex-direction: column
	overflow-x: hidden
	overflow-y: auto
	-webkit-overflow-scrolling: touch
	// @stylint off (overscroll-behavior unknown to the linter)
	overscroll-behavior: contain
	// @stylint on
	background: var(--color-bg)
	color: var(--color-label)
}

// Launch states are switched with the hidden attribute (see LaunchScreen.js
// and the inline script at the end of index.html).
.intro [hidden] {
	display: none !important
}

// Share links: small and quiet, top right
.intro__sharing {
	flex: none
	display: flex
	justify-content: flex-end
	gap: var(--space-1)
	padding-top: calc(env(safe-area-inset-top) + var(--space-2))
	padding-right: calc(env(safe-area-inset-right) + var(--space-3))
	padding-left: calc(env(safe-area-inset-left) + var(--space-3))
}

.intro__share-link {
	hit-target()
	display: inline-flex
	align-items: center
	justify-content: center
	border-radius: var(--radius-pill)
	color: var(--color-label-secondary)
	press-feedback()

	svg {
		width: 20px
		height: 20px
		fill: currentColor
	}

	&:hover {
		color: var(--color-label)
		background: var(--color-fill-secondary)
	}
}

// Main column
.intro__inner {
	flex: 1 0 auto
	display: flex
	flex-direction: column
	align-items: center
	justify-content: center
	width: 100%
	max-width: 960px
	margin: 0 auto
	padding-top: var(--space-5)
	padding-bottom: var(--space-7)
	padding-right: calc(env(safe-area-inset-right) + var(--space-5))
	padding-left: calc(env(safe-area-inset-left) + var(--space-5))
	text-align: center
}

.intro__title {
	width: 100%
	margin: 0
}

// The wordmark keeps its 4:1 shape; on short screens it gets smaller instead
// of pushing the actions out of view.
.intro__title-image {
	display: block
	width: 100%
	max-width: 880px
	height: auto
	max-height: 34vh
	margin: 0 auto
	object-fit: contain
}

.intro__text {
	max-width: $intro-content-width
	margin: var(--space-5) auto 0
	text-style(title-3)
	font-weight: 400
	color: var(--color-label)
}

.intro__content-desktop,
.intro__content-mobile,
.intro__content-mobile-incompatible {
	width: 100%
	max-width: $intro-content-width
	margin: var(--space-7) auto 0
}

.intro__cta,
.intro__content-mobile {
	display: flex
	flex-direction: column
	align-items: center
	gap: var(--space-3)
}

.intro__cta {
	margin: 0
}

// Secondary action: a plain (borderless) button beside the filled primary
.intro__secondary-button {
	hit-target()
	appearance: none
	margin: 0
	padding: var(--space-2) var(--space-5)
	border: 0
	border-radius: var(--radius-pill)
	background: none
	color: var(--color-accent)
	text-style(headline)
	cursor: pointer
	press-feedback()

	&:hover {
		background: var(--color-fill-secondary)
	}
}

.intro__hint {
	margin: var(--space-1) 0 0
	text-style(footnote)
	color: var(--color-label-secondary)
}

// Notes and messages (mobile note, missing camera support)
.intro__message {
	margin: 0
	text-style(callout)
	color: var(--color-label)

	& + & {
		margin-top: var(--space-3)
	}
}

.intro__footer {
	flex: none
	display: flex
	flex-wrap: wrap
	align-items: center
	justify-content: space-between
	gap: var(--space-3) var(--space-5)
	padding-top: var(--space-3)
	padding-right: calc(env(safe-area-inset-right) + var(--space-5))
	padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-4))
	padding-left: calc(env(safe-area-inset-left) + var(--space-5))
}

.intro__footer-link--left {
	display: block
	width: 240px
	max-width: 60%
}

.intro__footer-image {
	display: block
	width: 100%
	height: auto
}

.intro__footer-link--right {
	display: inline-flex
	align-items: center
	min-height: 44px
	text-style(footnote)
	color: var(--color-label-secondary)
}

@media (max-width: 599px) {
	.intro__text {
		text-style(body)
	}

	.intro__content-desktop,
	.intro__content-mobile,
	.intro__content-mobile-incompatible {
		margin-top: var(--space-6)
	}
}

// Landscape phones: little height, so tighten the vertical rhythm
@media (max-height: 500px) {
	.intro__inner {
		padding-top: 0
		padding-bottom: var(--space-4)
	}

	.intro__text {
		margin-top: var(--space-3)
	}

	.intro__content-desktop,
	.intro__content-mobile,
	.intro__content-mobile-incompatible {
		margin-top: var(--space-4)
	}
}

// Machine gets focus by script after the launch screen closes (it has
// tabindex="-1"); it isn't a control, so it doesn't need a focus ring.
#machine[tabindex="-1"]:focus {
	outline: none
}

// ---------------------------------------------------------------------------
// No-WebGL notice (built in LaunchScreen.js#showWebglWarning). A floating,
// dismissible banner, so it uses the glass material.
// ---------------------------------------------------------------------------

.webgl-banner {
	position: fixed
	z-index: 1001
	right: calc(env(safe-area-inset-right) + var(--space-3))
	bottom: calc(env(safe-area-inset-bottom) + var(--space-3))
	left: calc(env(safe-area-inset-left) + var(--space-3))
	display: flex
	flex-wrap: wrap
	align-items: center
	gap: var(--space-2) var(--space-4)
	max-width: 640px
	margin: 0 auto
	padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5)
	border-radius: var(--radius-l)
	color: var(--color-label)
	glass()
}

.webgl-banner__text {
	flex: 1 1 16em
	margin: 0
	text-style(subheadline)
}

.webgl-banner__button {
	hit-target()
	flex: none
	appearance: none
	margin: 0 0 0 auto
	padding: 0 var(--space-5)
	border: 0
	border-radius: var(--radius-pill)
	background: var(--color-accent-fill)
	color: var(--color-on-accent)
	text-style(headline)
	cursor: pointer
	press-feedback()
}
