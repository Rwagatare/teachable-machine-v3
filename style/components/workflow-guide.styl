// Not imported by main.styl (dead file).

.workflow-guide {
	max-width: 90%
	margin: var(--space-2) auto
	padding: var(--space-4)
	color: var(--color-label)
	text-align: center
	text-style(subheadline)
	background: var(--color-surface)
	border-radius: var(--radius-l)
	box-shadow: var(--shadow-card)

	&--hidden {
		display: none
	}
}

.workflow-step {
	display: inline-flex
	align-items: center
	justify-content: center
	width: 20px
	height: 20px
	margin-right: var(--space-1)
	color: var(--color-on-accent)
	text-style(caption)
	font-weight: 700
	background: unquote('var(--color-accent-fill, var(--color-accent))')
	border-radius: 50%
}