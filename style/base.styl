* {
	box-sizing: border-box
}

html {
	// @stylint off (color-scheme unknown to the linter)
	color-scheme: light dark
	// @stylint on
	-webkit-text-size-adjust: 100%
	text-size-adjust: 100%
	-webkit-font-smoothing: antialiased
	-moz-osx-font-smoothing: grayscale
}

body {
	margin: 0
	background: var(--color-bg)
	color: var(--color-label)
	//overflow-x: hidden
}

body.no-scroll {
	width: 100%
	height: 100%
	overflow: hidden
}

// Press-and-hold controls must not start a text selection or the iOS callout
// on long press. Text elsewhere stays selectable.
.button, button, [role="button"], .examples__wrapper, .wires, .input__media {
	user-select: none
	-webkit-user-select: none
	-webkit-touch-callout: none
}

// Keyboard focus
:focus-visible {
	focus-ring()
}

:focus:not(:focus-visible) {
	outline: none
}

// Visually hidden but still read by assistive technology
.hidden-text, .visually-hidden {
	position: absolute !important
	width: 1px !important
	height: 1px !important
	padding: 0 !important
	margin: -1px !important
	overflow: hidden !important
	clip: rect(0, 0, 0, 0) !important
	clip-path: inset(50%) !important
	white-space: nowrap !important
	border: 0 !important
}

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after {
		animation-duration: 0.01ms !important
		animation-iteration-count: 1 !important
		transition-duration: 0.01ms !important
		// @stylint off
		scroll-behavior: auto !important
		// @stylint on
	}
}
