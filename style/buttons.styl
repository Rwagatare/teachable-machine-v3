// ---------------------------------------------------------------------------
// Buttons (flat, HIG style). Markup: .button > .button__label (added by
// src/ui/components/Button.js) > .button__content. Works on <button> and on
// legacy <a class="button">.
//
//   .button            filled accent (Start Tutorial, Record a Video, Start
//                      Recording...)
//   .button--large     bigger call to action
//   .button--record    per-class Train button: tinted at rest, solid class
//                      colour while training (aria-pressed="true")
// ---------------------------------------------------------------------------

$button-classes = 'green' 'purple' 'orange' 'red' 'blue' 'yellow' 'teal' 'neutral'

.button {
	position: relative
	display: inline-flex
	align-items: center
	justify-content: center
	gap: var(--space-2)
	min-width: 44px
	min-height: 44px
	margin: 0
	padding: var(--space-2) var(--space-5)
	color: var(--color-on-accent)
	font: inherit
	text-style(headline)
	text-align: center
	text-decoration: none
	text-transform: none
	background: unquote('var(--color-accent-fill, var(--color-accent))')
	border: 0
	border-radius: var(--radius-pill)
	cursor: pointer
	-webkit-appearance: none
	appearance: none
	-webkit-tap-highlight-color: transparent
	touch-action: manipulation
	press-feedback()

	// Pressed by touch or keyboard (Button.js), where :active isn't reliable
	&.button--pressed {
		transform: scale(0.97)
		opacity: 0.8
	}

	@media (hover: hover) {
		&:hover {
			filter: brightness(1.08)
		}
	}

	@media (prefers-reduced-motion: reduce) {
		&.button--pressed {
			transform: none
		}
	}
}

.button:disabled,
.button[aria-disabled='true'],
.button--disabled,
.button.disabled,
.button.recording-start__button--disabled {
	opacity: 0.4
	filter: none
	cursor: default
	pointer-events: none
}

.button--large {
	min-height: 52px
	padding: var(--space-3) var(--space-6)
	text-style(title-3)
}

.button__label,
.button__content {
	display: inline-flex
	align-items: center
	justify-content: center
	gap: var(--space-2)
	min-width: 0
}

.button__label br {
	display: none
}

.button .icon {
	top: 0
	margin-right: 0
}

// Legacy toggle pair (input selector, currently unused)
.button-set {
	display: flex
	gap: var(--space-2)
	width: 100%
}

.button__toggle {
	flex: 1
	color: var(--color-label)
	background: var(--color-fill)
}

.button__toggle--selected {
	color: var(--color-on-accent)
	background: unquote('var(--color-accent-fill, var(--color-accent))')
}

// Per-class Train buttons
.button--record {
	width: 100%
	min-height: 48px
	padding: var(--space-2) var(--space-4)
	font-weight: 600
	border-radius: var(--radius-m)
	// Hold-to-train: don't let the browser turn the hold into a scroll/zoom
	touch-action: none
}

for cls in $button-classes {
	.button--record.button--color-{cls} {
		color: unquote('var(--class-' + cls + ')')
		background: unquote('var(--class-' + cls + '-tint)')

		&[aria-pressed='true'] {
			color: unquote('var(--class-' + cls + '-on)')
			background: unquote('var(--class-' + cls + ')')
		}
	}
}
