// System UI font stack. SF Pro is never bundled (licensed for Apple platforms
// only); -apple-system / system-ui resolve to it on Apple devices.
$font = -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif

.font__weight--regular {
	font-weight: 400
}

.font__weight--medium {
	font-weight: 500
}

.font__weight--semi-bold {
	font-weight: 600
}

.font__weight--bold {
	font-weight: 700
}

// Size utilities, remapped to the nearest HIG type role (rem, so they scale
// with the user's text size). Size only; weight/line-height come from context.
.font__size--xsmall {
	font-size: var(--text-caption-size)
}

.font__size--small {
	font-size: var(--text-subheadline-size)
}

.font__size--normal {
	font-size: var(--text-body-size)
}

.font__size--large {
	font-size: var(--text-headline-size)
}

.font__size--xlarge {
	font-size: var(--text-title-2-size)
}

.font__size--xxlarge {
	font-size: var(--text-title-1-size)
}

// Deprecated: HIG avoids all-caps labels. Kept until components stop using it.
.uppercase {
	text-transform: uppercase
}

html {
	font-family: $font
}

// iOS/iPadOS Safari: make rem follow the user's Dynamic Type setting. The
// font shorthand resets the family, so it is set again afterwards.
// -webkit-touch-callout limits this to iOS: macOS Safari also understands
// -apple-system-body but resolves it to 13px, which would shrink every rem.
@supports (font: -apple-system-body) and (-webkit-touch-callout: none) {
	html {
		font: -apple-system-body
		font-family: $font
	}
}

body {
	text-style(body)
}

html, body, input, button, select, textarea {
	font-family: $font
}

// Form fields inherit body size (>= 16px also stops iOS zooming on focus)
input, select, textarea {
	font-size: inherit
}

h1, h2, h3, h4 {
	margin: 0
	@extend .font__weight--semi-bold
}
